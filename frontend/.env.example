# Backend manzili (faqat dev rewrite va server tomonida)
BACKEND_URL=http://127.0.0.1:4000

# Saytning ommaviy manzili (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (ommaviy site key). Bo'sh bo'lsa captcha ko'rsatilmaydi (faqat dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analitika — faqat rozilikdan keyin yuklanadi (TZ 8.8). Bo'sh bo'lsa o'chiq.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# SEO: Google Search Console va Yandex Webmaster tasdiqlash kodlari (faqat kod, meta teg emas)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
